{
  "name": "@xivapi/lodestone-css-selectors",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of Lodestone CSS selectors and XPath expressions",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./character.json": "./json/character.json",
    "./cwls.json": "./json/cwls.json",
    "./freecompany.json": "./json/freecompany.json",
    "./linkshell.json": "./json/linkshell.json",
    "./metadata.json": "./json/metadata.json",
    "./pvpteam.json": "./json/pvpteam.json"
  },
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsx src/scripts/build.ts",
    "format": "biome format --write",
    "lint": "biome check --write"
  },
  "dependencies": {
    "@miichom/xpath2css": "^0.1.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.4.1",
    "consola": "^3.4.2",
    "picocolors": "^1.1.1",
    "std-env": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.10.0"
}
