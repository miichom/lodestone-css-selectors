{
  "entries": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "xpath": "/a[@class='entry__link--line']/@href",
          "selector": "a.entry__link--line",
          "attribute": "href",
          "type": "string",
          "pattern": "lodestone\\/crossworld_linkshell\\/(\\S+)\\/"
        },
        "name": {
          "type": "string",
          "xpath": "//p[@class='entry__name']/text()",
          "selector": "p.entry__name"
        },
        "dcname": {
          "type": "string",
          "xpath": "//p[@class='entry__world']/text()",
          "selector": "p.entry__world"
        },
        "members": {
          "type": "number",
          "xpath": "//div[@class='entry__linkshell__member']//span/text()",
          "selector": "div.entry__linkshell__member span"
        }
      },
      "required": [
        "id",
        "name",
        "dcname",
        "members"
      ]
    },
    "xpath": "//div[@class='ldst__window']//div[@class='entry']",
    "selector": "div.ldst__window div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "xpath": "//h3[@class='heading__linkshell__name']/text()",
        "selector": "h3.heading__linkshell__name"
      },
      "dcname": {
        "type": "string",
        "xpath": "//span[@class='heading__cwls__dcname']/text()",
        "selector": "span.heading__cwls__dcname"
      },
      "icon": {
        "type": "string",
        "format": "uri",
        "xpath": "//div[@class='heading__linkshell__icon']/img/@src",
        "selector": "div.heading__linkshell__icon > img",
        "attribute": "src"
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "xpath": "/a[@class='entry__link']/@href",
              "selector": "a.entry__link",
              "attribute": "href",
              "type": "string",
              "pattern": "lodestone\\/character\\/(\\d+)\\/"
            },
            "name": {
              "type": "string",
              "xpath": "//p[@class='entry__name']/text()",
              "selector": "p.entry__name"
            },
            "avatar": {
              "type": "string",
              "format": "uri",
              "xpath": "//div[@class='entry__chara__face']/img/@src",
              "selector": "div.entry__chara__face > img",
              "attribute": "src"
            },
            "worldname": {
              "xpath": "//p[@class='entry__world']/text()",
              "selector": "p.entry__world",
              "type": "string",
              "pattern": "(\\w+) \\[\\w+\\]"
            },
            "dcname": {
              "xpath": "//p[@class='entry__world']/text()",
              "selector": "p.entry__world",
              "type": "string",
              "pattern": "\\w+ \\[(\\w+)\\]"
            },
            "rank": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "xpath": "//div[@class='entry__chara_info__linkshell']/span/text()",
                  "selector": "div.entry__chara_info__linkshell > span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "xpath": "//div[@class='entry__chara_info__linkshell']/img/@src",
                  "selector": "div.entry__chara_info__linkshell > img",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ]
            },
            "grandcompany": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "(\\w+) \\/ \\w+",
                  "xpath": "//li[@class='js__tooltip']/@data-tooltip",
                  "selector": "li.js__tooltip",
                  "attribute": "data-tooltip"
                },
                "rank": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "\\w+ \\/ (\\w+)",
                      "xpath": "//li[@class='js__tooltip']/@data-tooltip",
                      "selector": "li.js__tooltip",
                      "attribute": "data-tooltip"
                    },
                    "icon": {
                      "type": "string",
                      "format": "uri",
                      "xpath": "//li[@class='js__tooltip']/img/@src",
                      "selector": "li.js__tooltip > img",
                      "attribute": "src"
                    }
                  },
                  "required": [
                    "name",
                    "icon"
                  ]
                }
              },
              "required": [
                "name",
                "rank"
              ]
            },
            "freecompany": {
              "type": "object",
              "properties": {
                "id": {
                  "xpath": "/a[@class='entry__freecompany__link']/@href",
                  "selector": "a.entry__freecompany__link",
                  "attribute": "href",
                  "type": "string",
                  "pattern": "lodestone\\/freecompany\\/(\\d+)\\/"
                },
                "name": {
                  "type": "string",
                  "xpath": "/a[@class='entry__freecompany__link']/span/text()",
                  "selector": "a.entry__freecompany__link > span"
                },
                "crest": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  },
                  "xpath": "/a[@class='entry__freecompany__link']//img/@src",
                  "selector": "a.entry__freecompany__link img",
                  "attribute": "src"
                }
              },
              "required": [
                "id",
                "name",
                "crest"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "avatar",
            "worldname",
            "dcname"
          ]
        },
        "xpath": "//div[@class='ls__member']/div[@class='entry']",
        "selector": "div.ls__member > div.entry"
      },
      "formed": {
        "xpath": "//span[@class='heading__cwls__formed']/span",
        "selector": "span.heading__cwls__formed > span"
      }
    },
    "required": [
      "name",
      "dcname",
      "icon",
      "members",
      "formed"
    ]
  },
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "q": {
        "type": "string"
      },
      "cf_public": {
        "type": "boolean"
      },
      "worldname": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "_region_1",
              "_region_2",
              "_region_3",
              "_region_4"
            ]
          },
          {
            "type": "string",
            "enum": [
              "_dc_Aether",
              "_dc_Crystal",
              "_dc_Dynamis",
              "_dc_Primal",
              "_dc_Chaos",
              "_dc_Light",
              "_dc_Materia",
              "_dc_Elemental",
              "_dc_Gaia",
              "_dc_Mana",
              "_dc_Meteor"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "character_count": {
        "type": "string",
        "enum": [
          "1-10",
          "11-30",
          "31-50",
          "51-"
        ]
      },
      "order": {
        "type": "number",
        "minimum": 1,
        "maximum": 6
      },
      "page": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "q"
    ]
  }
}