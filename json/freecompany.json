{
  "entries": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "xpath": "/a",
          "attribute": "href",
          "regex": "lodestone\\/freecompany\\/(\\S+)\\/",
          "css": "a"
        },
        "name": {
          "type": "string",
          "xpath": "//p[@class='entry__name']",
          "css": "p.entry__name"
        },
        "worldname": {
          "type": "string",
          "xpath": "//p[@class='entry__world'][2]",
          "regex": "(\\w+) \\[\\w+\\]",
          "css": "p.entry__world:nth-of-type(2)"
        },
        "dcname": {
          "type": "string",
          "xpath": "//p[@class='entry__world'][2]",
          "regex": "\\w+ \\[(\\w+)\\]",
          "css": "p.entry__world:nth-of-type(2)"
        },
        "crest": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "xpath": "//div[@class='entry__freecompany__crest__image']/img",
          "attribute": "src",
          "css": "div.entry__freecompany__crest__image > img"
        },
        "grandcompany": {
          "type": "string",
          "xpath": "//p[@class='entry__world'][1]",
          "css": "p.entry__world:first-of-type"
        },
        "members": {
          "type": "number",
          "xpath": "//li[@class='entry__freecompany__fc-member']",
          "css": "li.entry__freecompany__fc-member"
        },
        "estate": {
          "type": "string",
          "xpath": "//li[@class='entry__freecompany__fc-housing']",
          "css": "li.entry__freecompany__fc-housing"
        },
        "formed": {
          "type": "string",
          "xpath": "//li[@class='entry__freecompany__fc-day']/script",
          "regex": "ldst_strftime\\((\\d+)",
          "css": "li.entry__freecompany__fc-day > script"
        },
        "active": {
          "type": "boolean",
          "xpath": "//ul[contains(@class, 'entry__freecompany__fc-data')]/li[4]",
          "css": "ul[class*=\"entry__freecompany__fc-data\"] > li:nth-of-type(4)"
        },
        "recuiting": {
          "type": "boolean",
          "xpath": "//ul[contains(@class, 'entry__freecompany__fc-data')]/li[5]",
          "css": "ul[class*=\"entry__freecompany__fc-data\"] > li:nth-of-type(5)"
        }
      },
      "required": [
        "id",
        "name",
        "worldname",
        "dcname",
        "crest",
        "grandcompany",
        "members",
        "estate",
        "formed",
        "active",
        "recuiting"
      ],
      "additionalProperties": false
    },
    "xpath": "//div[@class='ldst__window']//div[@class='entry']",
    "css": "div.ldst__window div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "xpath": "//p[@class='entry__freecompany__name']",
        "css": "p.entry__freecompany__name"
      },
      "worldname": {
        "type": "string",
        "xpath": "//p[@class='entry__freecompany__gc'][2]",
        "regex": "(\\w+) \\[\\w+\\]",
        "css": "p.entry__freecompany__gc:nth-of-type(2)"
      },
      "dcname": {
        "type": "string",
        "xpath": "//p[@class='entry__freecompany__gc'][2]",
        "regex": "\\w+ \\[(\\w+)\\]",
        "css": "p.entry__freecompany__gc:nth-of-type(2)"
      },
      "grandcompany": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "xpath": "//p[@class='entry__freecompany__gc']",
            "regex": "(\\w+) <\\w+>",
            "css": "p.entry__freecompany__gc"
          },
          "rank": {
            "type": "string",
            "xpath": "//p[@class='entry__freecompany__gc']",
            "regex": "\\w+ <(\\w+)>",
            "css": "p.entry__freecompany__gc"
          }
        },
        "required": [
          "name",
          "rank"
        ],
        "additionalProperties": false
      },
      "tag": {
        "type": "string",
        "xpath": "//p[@class='freecompany__text freecompany__text__tag']",
        "css": "p.freecompany__text.freecompany__text__tag"
      },
      "slogan": {
        "type": "string",
        "xpath": "//p[@class='freecompany__text freecompany__text__message']",
        "css": "p.freecompany__text.freecompany__text__message"
      },
      "formed": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
        "xpath": "//p[@class='freecompany__text']/script",
        "regex": "ldst_strftime\\((\\d+)",
        "css": "p.freecompany__text > script"
      },
      "members": {
        "type": "number",
        "xpath": "//div[@class='ldst__window'][1]/p[6]",
        "css": "div.ldst__window:first-of-type > p:nth-of-type(6)"
      },
      "rank": {
        "type": "number",
        "xpath": "//div[@class='ldst__window'][1]/p[7]",
        "css": "div.ldst__window:first-of-type > p:nth-of-type(7)"
      },
      "reputation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p[@class='freecompany__reputation__gcname']",
              "css": "p.freecompany__reputation__gcname"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "/div[@class='freecompany__reputation__icon']/img",
              "attribute": "src",
              "css": "div.freecompany__reputation__icon > img"
            },
            "rank": {
              "type": "string",
              "xpath": "//p[@class='freecompany__reputation__rank']",
              "css": "p.freecompany__reputation__rank"
            }
          },
          "required": [
            "name",
            "icon",
            "rank"
          ],
          "additionalProperties": false
        },
        "xpath": "//div[@class='freecompany__reputation']",
        "css": "div.freecompany__reputation"
      },
      "rankings": {
        "type": "object",
        "properties": {
          "weekly": {
            "type": "number",
            "xpath": "//table[@class='character__ranking__data']//tr[1]/th",
            "regex": "(\\d+)",
            "css": "table.character__ranking__data tr:first-of-type > th"
          },
          "monthly": {
            "type": "number",
            "xpath": "//table[@class='character__ranking__data']//tr[2]/th",
            "regex": "(\\d+)",
            "css": "table.character__ranking__data tr:nth-of-type(2) > th"
          }
        },
        "required": [
          "weekly",
          "monthly"
        ],
        "additionalProperties": false
      },
      "estate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__name']",
            "css": "p.freecompany__estate__name"
          },
          "address": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__text']",
            "css": "p.freecompany__estate__text"
          },
          "greeting": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__greeting']",
            "css": "p.freecompany__estate__greeting"
          }
        },
        "required": [
          "name",
          "address",
          "greeting"
        ],
        "additionalProperties": false
      },
      "active": {
        "type": "string",
        "xpath": "//div[@class='ldst__window'][2]//p[@class='freecompany__text']",
        "css": "div.ldst__window:nth-of-type(2) p.freecompany__text"
      },
      "recruiting": {
        "type": "boolean",
        "xpath": "//p[@class='freecompany__recruitment']",
        "css": "p.freecompany__recruitment"
      },
      "focus": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p",
              "css": "p"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "//img",
              "attribute": "src",
              "css": "img"
            }
          },
          "required": [
            "name",
            "icon"
          ],
          "additionalProperties": false
        },
        "xpath": "//ul[@class='freecompany__focus_icon'][1]/li[not(@class)]",
        "css": "ul.freecompany__focus_icon:first-of-type > li:not([class])"
      },
      "seeking": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p",
              "css": "p"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "//img",
              "attribute": "src",
              "css": "img"
            }
          },
          "required": [
            "name",
            "icon"
          ],
          "additionalProperties": false
        },
        "xpath": "//ul[@class='freecompany__focus_icon'][2]/li[not(@class)]",
        "css": "ul.freecompany__focus_icon:nth-of-type(2) > li:not([class])"
      }
    },
    "required": [
      "name",
      "worldname",
      "dcname",
      "grandcompany",
      "tag",
      "slogan",
      "formed",
      "members",
      "rank",
      "reputation",
      "rankings",
      "active",
      "recruiting",
      "focus",
      "seeking"
    ],
    "additionalProperties": false
  },
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "q": {
        "type": "string"
      },
      "cf_public": {
        "type": "boolean"
      },
      "worldname": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "_region_1",
              "_region_2",
              "_region_3",
              "_region_4"
            ]
          },
          {
            "type": "string",
            "enum": [
              "_dc_Aether",
              "_dc_Crystal",
              "_dc_Dynamis",
              "_dc_Primal",
              "_dc_Chaos",
              "_dc_Light",
              "_dc_Materia",
              "_dc_Elemental",
              "_dc_Gaia",
              "_dc_Mana",
              "_dc_Meteor"
            ]
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          }
        ]
      },
      "character_count": {
        "type": "string",
        "enum": [
          "1-10",
          "11-30",
          "31-50",
          "51-"
        ]
      },
      "activities": {
        "type": "number",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          -1
        ]
      },
      "roles": {
        "type": "number",
        "enum": [
          16,
          17,
          18,
          19,
          20,
          -1
        ]
      },
      "activetime": {
        "type": "number",
        "enum": [
          1,
          2,
          3
        ]
      },
      "join": {
        "type": "boolean"
      },
      "house": {
        "type": "number",
        "enum": [
          0,
          1,
          2
        ]
      },
      "gcid": {
        "type": "number",
        "enum": [
          1,
          2,
          3,
          0
        ]
      },
      "order": {
        "type": "number",
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "page": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "q"
    ],
    "additionalProperties": false
  }
}