{
  "columns": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "member": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "xpath": "/a/@href",
              "selector": "a",
              "attribute": "href",
              "type": "string",
              "pattern": "lodestone\\/character\\/(\\d+)\\/"
            },
            "name": {
              "type": "string",
              "xpath": "//p[@class='entry__name']/text()",
              "selector": "p.entry__name"
            },
            "avatar": {
              "type": "string",
              "format": "uri",
              "xpath": "//div[@class='entry__chara__face']/img",
              "selector": "div.entry__chara__face > img"
            },
            "worldname": {
              "xpath": "//p[@class='entry__world']/text()",
              "selector": "p.entry__world",
              "type": "string",
              "pattern": "(\\w+) \\[\\w+\\]"
            },
            "dcname": {
              "xpath": "//p[@class='entry__world']/text()",
              "selector": "p.entry__world",
              "type": "string",
              "pattern": "\\w+ \\[(\\w+)\\]"
            },
            "rank": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "xpath": "//ul[@class='entry__freecompany__info']/li[1]/span/text()",
                  "selector": "ul.entry__freecompany__info > li:first-of-type > span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "xpath": "//ul[@class='entry__freecompany__info']/li[1]/img/@src",
                  "selector": "ul.entry__freecompany__info > li:first-of-type > img",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ]
            },
            "grandcompany": {
              "type": "object",
              "properties": {
                "name": {
                  "xpath": "//li[@class='js__tooltip']/@data-tooltip",
                  "selector": "li.js__tooltip",
                  "attribute": "data-tooltip",
                  "type": "string",
                  "pattern": "(\\w+) \\/ \\w+"
                },
                "rank": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "xpath": "//li[@class='js__tooltip']/@data-tooltip",
                      "selector": "li.js__tooltip",
                      "attribute": "data-tooltip",
                      "type": "string",
                      "pattern": "\\w+ \\/ (\\w+)"
                    },
                    "icon": {
                      "type": "string",
                      "format": "uri",
                      "xpath": "//li[@class='js__tooltip']/img/@src",
                      "selector": "li.js__tooltip > img",
                      "attribute": "src"
                    }
                  },
                  "required": [
                    "name",
                    "icon"
                  ]
                }
              },
              "required": [
                "name",
                "rank"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "avatar",
            "worldname",
            "dcname"
          ]
        },
        "xpath": "//div[@class='ldst__window']//li[@class='entry']",
        "selector": "div.ldst__window li.entry"
      }
    },
    "required": [
      "member"
    ]
  },
  "entries": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "xpath": "/a[@class='entry__block']/@href",
          "selector": "a.entry__block",
          "attribute": "href",
          "type": "string",
          "pattern": "lodestone\\/freecompany\\/(\\d+)\\/"
        },
        "name": {
          "type": "string",
          "xpath": "//p[@class='entry__name']/text()",
          "selector": "p.entry__name"
        },
        "worldname": {
          "xpath": "//p[@class='entry__world'][2]/text()",
          "selector": "p.entry__world:nth-of-type(2)",
          "type": "string",
          "pattern": "(\\w+) \\[\\w+\\]"
        },
        "dcname": {
          "xpath": "//p[@class='entry__world'][2]/text()",
          "selector": "p.entry__world:nth-of-type(2)",
          "type": "string",
          "pattern": "\\w+ \\[(\\w+)\\]"
        },
        "crest": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "xpath": "//div[@class='entry__freecompany__crest__image']/img/@src",
          "selector": "div.entry__freecompany__crest__image > img",
          "attribute": "src"
        },
        "grandcompany": {
          "type": "string",
          "xpath": "//p[@class='entry__world'][1]/text()",
          "selector": "p.entry__world:first-of-type"
        },
        "members": {
          "type": "number",
          "xpath": "//li[@class='entry__freecompany__fc-member']/text()",
          "selector": "li.entry__freecompany__fc-member"
        },
        "estate": {
          "type": "string",
          "xpath": "//li[@class='entry__freecompany__fc-housing']/text()",
          "selector": "li.entry__freecompany__fc-housing"
        },
        "formed": {
          "xpath": "//li[@class='entry__freecompany__fc-day']/script/text()",
          "selector": "li.entry__freecompany__fc-day > script",
          "type": "string",
          "pattern": "ldst_strftime\\((\\d+)"
        },
        "active": {
          "xpath": "//ul[contains(@class, 'entry__freecompany__fc-data')]/li[4]/text()",
          "selector": "ul[class*=\"entry__freecompany__fc-data\"] > li:nth-of-type(4)",
          "type": "string"
        },
        "recuiting": {
          "xpath": "//ul[contains(@class, 'entry__freecompany__fc-data')]/li[5]/text()",
          "selector": "ul[class*=\"entry__freecompany__fc-data\"] > li:nth-of-type(5)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "worldname",
        "dcname",
        "crest",
        "grandcompany",
        "members",
        "estate",
        "formed",
        "active",
        "recuiting"
      ]
    },
    "xpath": "//div[@class='ldst__window']//div[@class='entry']",
    "selector": "div.ldst__window div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "xpath": "//p[@class='entry__freecompany__name']/text()",
        "selector": "p.entry__freecompany__name"
      },
      "worldname": {
        "xpath": "//p[@class='entry__freecompany__gc'][2]/text()",
        "selector": "p.entry__freecompany__gc:nth-of-type(2)",
        "type": "string",
        "pattern": "(\\w+) \\[\\w+\\]"
      },
      "dcname": {
        "xpath": "//p[@class='entry__freecompany__gc'][2]/text()",
        "selector": "p.entry__freecompany__gc:nth-of-type(2)",
        "type": "string",
        "pattern": "\\w+ \\[(\\w+)\\]"
      },
      "grandcompany": {
        "type": "object",
        "properties": {
          "name": {
            "xpath": "//p[@class='entry__freecompany__gc']/text()",
            "selector": "p.entry__freecompany__gc",
            "type": "string",
            "pattern": "(\\w+) <\\w+>"
          },
          "rank": {
            "xpath": "//p[@class='entry__freecompany__gc']/text()",
            "selector": "p.entry__freecompany__gc",
            "type": "string",
            "pattern": "\\w+ <(\\w+)>"
          }
        },
        "required": [
          "name",
          "rank"
        ]
      },
      "tag": {
        "type": "string",
        "xpath": "//p[@class='freecompany__text freecompany__text__tag']/text()",
        "selector": "p.freecompany__text.freecompany__text__tag"
      },
      "slogan": {
        "type": "string",
        "xpath": "//p[@class='freecompany__text freecompany__text__message']/text()",
        "selector": "p.freecompany__text.freecompany__text__message"
      },
      "formed": {
        "xpath": "//p[@class='freecompany__text']/script/text()",
        "selector": "p.freecompany__text > script",
        "type": "string",
        "pattern": "ldst_strftime\\((\\d+)"
      },
      "members": {
        "type": "number",
        "xpath": "//div[@class='ldst__window'][1]/p[6]/text()",
        "selector": "div.ldst__window:first-of-type > p:nth-of-type(6)"
      },
      "rank": {
        "type": "number",
        "xpath": "//div[@class='ldst__window'][1]/p[7]/text()",
        "selector": "div.ldst__window:first-of-type > p:nth-of-type(7)"
      },
      "reputation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p[@class='freecompany__reputation__gcname']/text()",
              "selector": "p.freecompany__reputation__gcname"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "/div[@class='freecompany__reputation__icon']/img/@src",
              "selector": "div.freecompany__reputation__icon > img",
              "attribute": "src"
            },
            "rank": {
              "type": "string",
              "xpath": "//p[@class='freecompany__reputation__rank']/text()",
              "selector": "p.freecompany__reputation__rank"
            }
          },
          "required": [
            "name",
            "icon",
            "rank"
          ]
        },
        "xpath": "//div[@class='freecompany__reputation']",
        "selector": "div.freecompany__reputation"
      },
      "rankings": {
        "type": "object",
        "properties": {
          "weekly": {
            "xpath": "//table[@class='character__ranking__data']//tr[1]/th/text()",
            "selector": "table.character__ranking__data tr:first-of-type > th",
            "type": "string",
            "pattern": "(\\d+)"
          },
          "monthly": {
            "xpath": "//table[@class='character__ranking__data']//tr[2]/th/text()",
            "selector": "table.character__ranking__data tr:nth-of-type(2) > th",
            "type": "string",
            "pattern": "(\\d+)"
          }
        },
        "required": [
          "weekly",
          "monthly"
        ]
      },
      "estate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__name']/text()",
            "selector": "p.freecompany__estate__name"
          },
          "address": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__text']/text()",
            "selector": "p.freecompany__estate__text"
          },
          "greeting": {
            "type": "string",
            "xpath": "//p[@class='freecompany__estate__greeting']/text()",
            "selector": "p.freecompany__estate__greeting"
          }
        },
        "required": [
          "name",
          "address",
          "greeting"
        ]
      },
      "active": {
        "type": "string",
        "xpath": "//div[@class='ldst__window'][2]//p[@class='freecompany__text']/text()",
        "selector": "div.ldst__window:nth-of-type(2) p.freecompany__text"
      },
      "recruiting": {
        "xpath": "//p[@class='freecompany__recruitment']/text()",
        "selector": "p.freecompany__recruitment",
        "type": "string"
      },
      "focus": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p",
              "selector": "p"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "//img",
              "selector": "img"
            }
          },
          "required": [
            "name",
            "icon"
          ]
        },
        "xpath": "//ul[@class='freecompany__focus_icon'][1]/li[not(@class)]/text()",
        "selector": "ul.freecompany__focus_icon:first-of-type > li:not([class])"
      },
      "seeking": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "xpath": "//p",
              "selector": "p"
            },
            "icon": {
              "type": "string",
              "format": "uri",
              "xpath": "//img",
              "selector": "img"
            }
          },
          "required": [
            "name",
            "icon"
          ]
        },
        "xpath": "//ul[@class='freecompany__focus_icon'][2]/li[not(@class)]/text()",
        "selector": "ul.freecompany__focus_icon:nth-of-type(2) > li:not([class])"
      }
    },
    "required": [
      "name",
      "worldname",
      "dcname",
      "grandcompany",
      "tag",
      "slogan",
      "formed",
      "members",
      "rank",
      "reputation",
      "rankings",
      "active",
      "recruiting",
      "focus",
      "seeking"
    ]
  },
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "q": {
        "type": "string"
      },
      "cf_public": {
        "type": "boolean"
      },
      "worldname": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "_region_1",
              "_region_2",
              "_region_3",
              "_region_4"
            ]
          },
          {
            "type": "string",
            "enum": [
              "_dc_Aether",
              "_dc_Crystal",
              "_dc_Dynamis",
              "_dc_Primal",
              "_dc_Chaos",
              "_dc_Light",
              "_dc_Materia",
              "_dc_Elemental",
              "_dc_Gaia",
              "_dc_Mana",
              "_dc_Meteor"
            ]
          },
          {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          }
        ]
      },
      "character_count": {
        "type": "string",
        "enum": [
          "1-10",
          "11-30",
          "31-50",
          "51-"
        ]
      },
      "activities": {
        "type": "number",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          -1
        ]
      },
      "roles": {
        "type": "number",
        "enum": [
          16,
          17,
          18,
          19,
          20,
          -1
        ]
      },
      "activetime": {
        "type": "number",
        "enum": [
          1,
          2,
          3
        ]
      },
      "join": {
        "type": "boolean"
      },
      "house": {
        "type": "number",
        "enum": [
          0,
          1,
          2
        ]
      },
      "gcid": {
        "type": "number",
        "enum": [
          1,
          2,
          3,
          0
        ]
      },
      "order": {
        "type": "number",
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "page": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "q"
    ]
  }
}