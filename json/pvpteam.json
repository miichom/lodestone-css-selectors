{
  "entries": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "xpath": "/a",
          "attribute": "href",
          "selector": "a",
          "type": "string",
          "pattern": "lodestone\\/pvpteam\\/(\\S+)\\/"
        },
        "name": {
          "type": "string",
          "xpath": "//p[@class='entry__name']",
          "selector": "p.entry__name"
        },
        "dcname": {
          "type": "string",
          "xpath": "//p[@class='entry__world']",
          "selector": "p.entry__world"
        },
        "crest": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "xpath": "//div[@class='entry__pvpteam__search__crest__image']/img",
          "attribute": "src",
          "selector": "div.entry__pvpteam__search__crest__image > img"
        }
      },
      "required": [
        "id",
        "name",
        "dcname",
        "crest"
      ]
    },
    "xpath": "//div[@class='ldst__window']//div[@class='entry']",
    "selector": "div.ldst__window div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "xpath": "//h2[@class='entry__pvpteam__name--team']"
      },
      "dcname": {
        "type": "string",
        "xpath": "//p[@class='entry__pvpteam__name--dc']"
      },
      "crest": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "xpath": "//div[@class='entry__pvpteam__crest__image']/img",
        "attribute": "src"
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "xpath": "/a[@class='entry__bg']",
              "attribute": "href"
            },
            "name": {
              "type": "string",
              "xpath": "//p[@class='entry__name']"
            },
            "avatar": {
              "type": "string",
              "format": "uri",
              "xpath": "//div[@class='entry__chara__face']/img",
              "attribute": "src"
            },
            "worldname": {
              "xpath": "//p[@class='entry__world']",
              "type": "string",
              "pattern": "(\\w+) \\[\\w+\\]"
            },
            "dcname": {
              "xpath": "//p[@class='entry__world']",
              "type": "string",
              "pattern": "\\w+ \\[(\\w+)\\]"
            },
            "rank": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "xpath": "//ul[contains(@class, 'info')]/li/img[not(@class)]/following-sibling::span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "xpath": "//ul[contains(@class, 'info')]/li[span]/img[not(@class)]",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ]
            },
            "grandcompany": {
              "type": "object",
              "properties": {
                "name": {
                  "xpath": "//li[@class='js__tooltip']",
                  "attribute": "data-tooltip",
                  "type": "string",
                  "pattern": "(\\w+) \\/ \\w+"
                },
                "rank": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "xpath": "//li[@class='js__tooltip']",
                      "attribute": "data-tooltip",
                      "type": "string",
                      "pattern": "\\w+ \\/ (\\w+)"
                    },
                    "icon": {
                      "type": "string",
                      "format": "uri",
                      "xpath": "//li[@class='js__tooltip']/img",
                      "attribute": "src"
                    }
                  },
                  "required": [
                    "name",
                    "icon"
                  ]
                }
              },
              "required": [
                "name",
                "rank"
              ]
            },
            "matches": {
              "xpath": "//ul[contains(@class, '__info')]/li/img[contains(@class, 'entry__pvpteam__battle__icon')]/following-sibling::span",
              "type": "number"
            }
          },
          "required": [
            "id",
            "name",
            "avatar",
            "worldname",
            "dcname"
          ]
        },
        "xpath": "//div[@class='pvpteam__member']/div[@class='entry']"
      },
      "formed": {
        "xpath": "//span[@class='entry__pvpteam__data--formed']/span",
        "type": "string"
      }
    },
    "required": [
      "name",
      "dcname",
      "crest",
      "members",
      "formed"
    ]
  },
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "q": {
        "type": "string"
      },
      "cf_public": {
        "type": "boolean"
      },
      "worldname": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "_region_1",
              "_region_2",
              "_region_3",
              "_region_4"
            ]
          },
          {
            "type": "string",
            "enum": [
              "_dc_Aether",
              "_dc_Crystal",
              "_dc_Dynamis",
              "_dc_Primal",
              "_dc_Chaos",
              "_dc_Light",
              "_dc_Materia",
              "_dc_Elemental",
              "_dc_Gaia",
              "_dc_Mana",
              "_dc_Meteor"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "order": {
        "type": "number",
        "minimum": 1,
        "maximum": 4
      },
      "page": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "q"
    ]
  }
}